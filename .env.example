# ==============================================================================
# YouTube Multi-Publisher & AI Video Factory - Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Atlas Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ytb-multi

# LLM Story & Script Engine (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Visual Generation & Image Providers (Phase 3B)
# Supported Providers: google-imagen | replicate | mock-test-provider
IMAGE_PROVIDER=google-imagen

# Provider Fallback Chain (Comma-separated list of provider IDs to try if primary fails)
# Example: replicate,mock-test-provider
IMAGE_PROVIDER_FALLBACKS=replicate

# Google Imagen 3 Configuration
IMAGEN_MODEL=imagen-3.0-generate-002

# Replicate AI Configuration (Flux / SDXL / IP-Adapter)
REPLICATE_API_TOKEN=your_replicate_api_token_here
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# Uploads & Storage Directories
UPLOAD_DIR=public/uploads
VISUAL_ASSETS_DIR=public/uploads/visual-assets
